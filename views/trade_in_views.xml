<odoo>
    <data>

        <record id="trade_in_view_tree" model="ir.ui.view">
            <field name="name">trade_in_program.trade_in.tree</field>
            <field name="model">trade_in_program.trade_in</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="partner_id"/>
                    <field name="partner_email"/>
                    <field name="device_id"/>
                    <field name="condition_id"/>
                    <field name="offer_value"/>
                    <field name="reference"/>
                    <field name="status"/>
                    <field name="rejection_reason"/>
                    <button name="action_approve" type="object" string="Approve" icon="fa-check"/>
                    <button name="action_reject" type="object" string="Reject" icon="fa-times"/>
                </tree>
            </field>
        </record>

        <record id="trade_in_view_form" model="ir.ui.view">
            <field name="name">trade_in_program.trade_in.form</field>
            <field name="model">trade_in_program.trade_in</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="partner_id"/>
                                <field name="device_id" options="{'no_create': True}"/>
                                <field name="condition_id" options="{'no_create': True}" widget="radio"/>
                            </group>
                            <group>
                                <field name="base_value"/>
                                <field name="multiplier"/>
                                <field name="offer_value"/>
                            </group>
                            <group>
                                <field name="reference" readonly="true"/>
                                <field name="status"/>
                                <field name="rejection_reason"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="trade_in_action" model="ir.actions.act_window">
            <field name="name">Trade In</field>
            <field name="res_model">trade_in_program.trade_in</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>