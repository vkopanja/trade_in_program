<odoo>
    <data>

        <template id="trade_in_program.trade_in_form" name="Trade-In Request">
            <t t-call="web.frontend_layout">
                <div class="container mt-4">
                    <h1>Request a Trade-In Offer</h1>
                    <form action="/trade-in/submit" id="trade_in_form" method="post" class="mt-3">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                        <div class="mb-3">
                            <label class="form-label">Customer Name</label>
                            <input type="text" name="customer_name" class="form-control" required="required"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Customer Email</label>
                            <input type="email" name="customer_email" class="form-control" required="required"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Device</label>
                            <select name="device_id" class="form-select" required="required">
                                <option value="">Select a device</option>
                                <t t-foreach="devices" t-as="d">
                                    <option t-att-value="d.id" t-esc="d.model_name"/>
                                </t>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Condition</label>
                            <select name="condition_id" class="form-select" required="required">
                                <option value="">Select a condition</option>
                                <t t-foreach="conditions" t-as="c">
                                    <option t-att-value="c.id" t-esc="c.condition"/>
                                </t>
                            </select>
                        </div>

                        <div class="mb-3">
                            <p class="mt-3">Estimated value:
                                <strong id="quote">-</strong>
                            </p>
                        </div>

                        <button type="submit" class="btn btn-primary">Get Offer</button>
                    </form>
                </div>
                <script type="text/javascript">
                    document.addEventListener('DOMContentLoaded', function () {
                        const form = document.getElementById('trade_in_form');
                        const out = document.getElementById('quote');

                        async function refreshQuote() {
                            const device = form.device_id.value;
                            const condition = form.condition_id.value;

                            if (!device || !condition) {
                                out.textContent = '-';
                                return;
                            }

                            const res = await fetch('/trade-in/quote', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({
                                    jsonrpc: "2.0",
                                    method: "call",
                                    params: {device_id: device, condition_id: condition},
                                }),
                            });
                            const data = await res.json();
                            out.textContent = data.result &amp;&amp; data.result.ok
                                ? data.result.value.toFixed(2) : '-';
                        }

                        form.device_id.addEventListener('change', refreshQuote)
                        form.condition_id.addEventListener('change', refreshQuote)
                    });
                </script>
            </t>
        </template>

    </data>
</odoo>
