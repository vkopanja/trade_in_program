<odoo>
    <data>

        <template id="trade_in_program.trade_in_form" name="Trade-In Request">
            <t t-call="website.layout">
                <div class="container o_trade_in my-4">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <h1>Request a Trade-In Offer</h1>
                            <div t-if="reference" class="alert alert-success mt-3" role="alert">
                                <p>Thank you for submitting your trade-in request. We will be in touch shortly.</p>
                                <p class="mb-0">Your reference number is
                                    <strong>
                                        <t t-esc="reference"/>
                                    </strong>
                                </p>
                            </div>
                            <form t-if="devices and conditions" action="/trade-in/submit" id="trade_in_form"
                                  method="post" class="mt-3">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="submission_token" t-att-value="submission_token"/>

                                <div class="mb-3">
                                    <label class="form-label">Customer Name</label>
                                    <input type="text" name="customer_name" required="required"
                                           t-att-value="form_values.get('customer_name')"
                                           t-att-maxlength="max_name_length"
                                           t-attf-class="form-control #{'is-invalid' if form_errors.get('customer_name') else ''}"/>
                                    <div t-if="form_errors.get('customer_name')" class="invalid-feedback"
                                         t-esc="form_errors['customer_name']"/>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Customer Email</label>
                                    <input type="email" name="customer_email" required="required"
                                           t-att-value="form_values.get('customer_email')"
                                           t-attf-class="form-control #{'is-invalid' if form_errors.get('email') else ''}"/>
                                    <div t-if="form_errors.get('email')" class="invalid-feedback"
                                         t-esc="form_errors['email']"/>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Device</label>
                                    <select name="device_id" required="required"
                                            t-attf-class="form-select #{'is-invalid' if form_errors.get('invalid') else ''}">
                                        <option value="">Select a device</option>
                                        <t t-foreach="devices" t-as="d">
                                            <option t-att-value="d.id"
                                                    t-att-selected="str(d.id) == form_values.get('device_id')"
                                                    t-esc="d.model_name"/>
                                        </t>
                                    </select>
                                    <div t-if="form_errors.get('invalid')" class="invalid-feedback"
                                         t-esc="form_errors['invalid']"/>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Condition</label>
                                    <select name="condition_id" required="required"
                                            t-attf-class="form-select #{'is-invalid' if form_errors.get('invalid') else ''}">
                                        <option value="">Select a condition</option>
                                        <t t-foreach="conditions" t-as="c">
                                            <option t-att-value="c.id"
                                                    t-att-selected="str(c.id) == form_values.get('condition_id')"
                                                    t-esc="c.condition"/>
                                        </t>
                                    </select>
                                    <div t-if="form_errors.get('invalid')" class="invalid-feedback"
                                         t-esc="form_errors['invalid']"/>
                                </div>

                                <div class="o_trade_in_estimate mb-3">
                                    <span>Estimated value</span>
                                    <strong id="quote" class="o_trade_in_quote">-</strong>
                                </div>

                                <button type="submit" class="btn btn-primary o_trade_in_submit">Get Offer</button>
                            </form>
                            <div t-else="" class="alert alert-info mt-3" role="status">
                                We are not accepting trade-ins at the moment. Please check back soon.
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

    </data>
</odoo>
