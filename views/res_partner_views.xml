<odoo>
    <data>

        <record id="res_partner_view_form_trade_in" model="ir.ui.view">
            <field name="name">res.partner.form.trade_in</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button class="oe_stat_button" type="object" name="action_view_trade_ins"
                            icon="fa-exchange" groups="trade_in_program.group_trade_in_user">
                        <field name="trade_in_count" widget="statinfo" string="Trade-Ins"/>
                    </button>
                </div>
            </field>
        </record>

    </data>
</odoo>
