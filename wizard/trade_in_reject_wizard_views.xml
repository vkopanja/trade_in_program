<odoo>
    <data>

        <record id="trade_in_reject_wizard_view_form" model="ir.ui.view">
            <field name="name">trade_in_program.reject.wizard.form</field>
            <field name="model">trade_in_program.reject.wizard</field>
            <field name="arch" type="xml">
                <form string="Reject Trade-In">
                    <field name="trade_in_id" invisible="1"/>
                    <group>
                        <field name="rejection_reason" placeholder="Why is this request rejected?"/>
                    </group>
                    <footer>
                        <button name="action_reject" string="Reject" type="object" class="btn-primary"/>
                        <button special="cancel" string="Cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>