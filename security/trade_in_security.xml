<odoo>
    <data>

        <record id="module_category_trade_in" model="ir.module.category">
            <field name="name">Trade-In</field>
            <field name="sequence">50</field>
        </record>

        <record id="group_trade_in_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_trade_in"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_trade_in_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_trade_in"/>
            <field name="implied_ids" eval="[(4, ref('group_trade_in_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
